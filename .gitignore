# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# Role passwords and dumps. Never commit these.
secrets/
*.dump

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE
.vscode/launch.json
.vscode/tasks.json
.vscode/*.code-workspace
.idea/
*.swp
*.swo

# Allow shared VSCode settings at repo root only
!/.vscode/settings.json
!/.vscode/extensions.json

# OS / local
TODO.md
*.tmp
*.temp
